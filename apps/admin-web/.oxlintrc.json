{
  "plugins": ["react", "typescript", "oxc", "unicorn", "import", "jsx-a11y", "jsdoc", "vitest"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "ignorePatterns": ["src/api/endpoints/**", "src/models/**", "src/gen/**", "reports/**"]
}
