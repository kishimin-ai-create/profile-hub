{
  "name": "@profile-hub/admin-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint --fix .",
    "lint:markup": "markuplint \"src/**/*.tsx\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:small": "vitest run --passWithNoTests small.test",
    "test:medium": "vitest run --passWithNoTests medium.test",
    "test:large": "vitest run --passWithNoTests large.test",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:coverage:pr": "COVERAGE_THRESHOLD=80 vitest run --coverage --passWithNoTests small.test medium.test",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "vrt:capture": "storycap --serverCmd \"bunx serve storybook-static -p 6007\" http://localhost:6007",
    "vrt": "reg-suit run",
    "api:generate": "orval"
  },
  "dependencies": {
    "@profile-hub/types": "workspace:*",
    "@profile-hub/utils": "workspace:*",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "axios": "^1.16.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@markuplint/jsx-parser": "^4.18.3",
    "@markuplint/react-spec": "^4.18.0",
    "@playwright/test": "^1.60.0",
    "@profile-hub/config": "workspace:*",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.1.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "9.39.5",
    "jsdom": "^29.1.1",
    "markuplint": "^4.18.3",
    "msw": "^2.14.6",
    "msw-storybook-addon": "^2.0.7",
    "orval": "^8.14.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.8.3",
    "reg-publish-filesystem-plugin": "^0.2.0",
    "reg-simple-keygen-plugin": "^0.14.2",
    "reg-suit": "^0.14.5",
    "storybook": "^10.4.1",
    "storycap": "^5.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "trustedDependencies": [
    "esbuild",
    "msw",
    "sharp",
    "unrs-resolver"
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
