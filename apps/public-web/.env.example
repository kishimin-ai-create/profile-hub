# Base URL the browser uses to reach the public API.
VITE_API_URL=http://localhost:3001

# OpenAPI document consumed by `bun run api:generate`.
OPENAPI_URL=http://localhost:3001/openapi.json

# Set to run Playwright against a deployed environment instead of `bun run dev`.
PLAYWRIGHT_BASE_URL=https://your-public-web.example.com
